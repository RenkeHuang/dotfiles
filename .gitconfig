# git configuration file
[user]
        name = Renke Huang
        email = ...
[core]
        excludesfile = ~/.gitignore_global
        editor = vi
[push]
        default = tracking
[pull]
        default = current
		    rebase = true
[color]
        ui = true
[color "branch"]
        current = yellow reverse
        local = yellow
        remote = green
[color "diff"]
        meta = yellow bold
        frag = magenta bold
        old = red bold
        new = green bold
[color "status"]
        added = yellow
        changed = green
        untracked = cyan
[alias]
        # common typo:       
        satus = status
[fetch]
		    prune = true
